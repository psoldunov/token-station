{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot",
  "description": "The whole state published to front ends.",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "integer",
      "format": "int64"
    },
    "meter": {
      "$ref": "#/$defs/Meter"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderSnapshot"
      }
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "generatedAt",
    "meter",
    "providers"
  ],
  "$defs": {
    "AccountTokens": {
      "description": "Account-wide token usage reported by the provider backend (all devices).",
      "type": "object",
      "properties": {
        "daily": {
          "description": "Oldest first, at most 30 entries.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DailyTokens"
          }
        },
        "last7Days": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "lifetime": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "today": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "today",
        "last7Days",
        "daily",
        "updatedAt"
      ]
    },
    "BreakdownRow": {
      "description": "Share of the weekly window per surface (Claude only: \"Claude Code 97 %\").",
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "percent": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "key",
        "label",
        "percent"
      ]
    },
    "Credits": {
      "description": "Paid overage / credit balance (Claude \"extra usage\", Codex credits).",
      "type": "object",
      "properties": {
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "description": "Free-form extra line, e.g. \"1 reset credit available\".",
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "limit": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "used": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "label",
        "enabled"
      ]
    },
    "DailyTokens": {
      "type": "object",
      "properties": {
        "date": {
          "description": "Local calendar date, `YYYY-MM-DD`.",
          "type": "string"
        },
        "tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "date",
        "tokens"
      ]
    },
    "Level": {
      "description": "Severity derived from the configured warning/critical thresholds.",
      "type": "string",
      "enum": [
        "normal",
        "warning",
        "critical"
      ]
    },
    "Meter": {
      "type": "object",
      "properties": {
        "bars": {
          "description": "One bar per provider in [`ProviderId::ALL`] order (disabled providers omitted).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MeterBar"
          }
        },
        "level": {
          "description": "Worst level across bars.",
          "$ref": "#/$defs/Level"
        }
      },
      "required": [
        "bars",
        "level"
      ]
    },
    "MeterBar": {
      "description": "One bar of the tray mini-meter.",
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/Level"
        },
        "percent": {
          "description": "0–100, or `None` when the provider has no data (draw an empty outline).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "windowId": {
          "description": "Window the bar represents.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "level"
      ]
    },
    "ModelTotals": {
      "description": "Token totals in disjoint buckets.\n\n`total = input + cacheRead + cacheWrite + output`. `reasoning` is a subset of\n`output`, shown for information only.",
      "type": "object",
      "properties": {
        "cacheRead": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cacheWrite": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "costUsd": {
          "description": "API-equivalent cost of the priced part, if any model was priced.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "output": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reasoning": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "unpricedTokens": {
          "description": "Tokens whose model had no known price.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "model",
        "input",
        "output",
        "cacheRead",
        "cacheWrite",
        "reasoning",
        "total",
        "unpricedTokens",
        "requests"
      ]
    },
    "ProviderId": {
      "description": "A usage provider (one CLI).",
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ]
    },
    "ProviderSnapshot": {
      "type": "object",
      "properties": {
        "accountTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountTokens"
            },
            {
              "type": "null"
            }
          ]
        },
        "breakdown": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/BreakdownRow"
          }
        },
        "credits": {
          "anyOf": [
            {
              "$ref": "#/$defs/Credits"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/ProviderId"
        },
        "message": {
          "description": "User-facing explanation for non-`ok` states.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "plan": {
          "description": "Plan label, e.g. \"Max 20x\", \"Pro\".",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ProviderState"
        },
        "tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "description": "Last successful plan-limit refresh.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UsageWindow"
          }
        }
      },
      "required": [
        "id",
        "name",
        "state",
        "windows"
      ]
    },
    "ProviderState": {
      "description": "Health of one provider's data.",
      "oneOf": [
        {
          "description": "No data yet (first refresh in flight).",
          "type": "string",
          "const": "loading"
        },
        {
          "description": "Fresh data.",
          "type": "string",
          "const": "ok"
        },
        {
          "description": "Showing the last good data; `message` says why it could not refresh.",
          "type": "string",
          "const": "stale"
        },
        {
          "description": "The CLI is installed but not signed in (or the sign-in expired).",
          "type": "string",
          "const": "unauthenticated"
        },
        {
          "description": "The CLI and its data directory were not found.",
          "type": "string",
          "const": "not_installed"
        },
        {
          "description": "Turned off in settings.",
          "type": "string",
          "const": "disabled"
        },
        {
          "description": "Refresh failed and there is no previous data to show.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "TokenReport": {
      "description": "Token usage recorded in this machine's local CLI logs.",
      "type": "object",
      "properties": {
        "byModel": {
          "description": "Last 7 days, most expensive first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelTotals"
          }
        },
        "last7Days": {
          "$ref": "#/$defs/TokenTotals"
        },
        "today": {
          "$ref": "#/$defs/TokenTotals"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "today",
        "last7Days",
        "byModel",
        "updatedAt"
      ]
    },
    "TokenTotals": {
      "description": "Token totals in disjoint buckets.\n\n`total = input + cacheRead + cacheWrite + output`. `reasoning` is a subset of\n`output`, shown for information only.",
      "type": "object",
      "properties": {
        "cacheRead": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cacheWrite": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "costUsd": {
          "description": "API-equivalent cost of the priced part, if any model was priced.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reasoning": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "unpricedTokens": {
          "description": "Tokens whose model had no known price.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "input",
        "output",
        "cacheRead",
        "cacheWrite",
        "reasoning",
        "total",
        "unpricedTokens",
        "requests"
      ]
    },
    "UsageWindow": {
      "description": "One rate-limit window, e.g. \"Session · 34 % · resets 23:30\".",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable id, e.g. `session`, `weekly_all`, `weekly_scoped:fable`, `codex:primary`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WindowKind"
        },
        "label": {
          "description": "Human label, e.g. \"Session\", \"Weekly\", \"Weekly · Fable\".",
          "type": "string"
        },
        "level": {
          "description": "Filled in by [`crate::assemble::assemble`] from the configured thresholds.",
          "$ref": "#/$defs/Level",
          "default": "normal"
        },
        "observedAt": {
          "description": "When the value was observed.",
          "type": "integer",
          "format": "int64"
        },
        "resetsAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "source": {
          "description": "Where the value came from: `oauth`, `statusline`, `app-server`, `http`, `rollout`.",
          "type": "string"
        },
        "usedPercent": {
          "description": "0–100.",
          "type": "number",
          "format": "double"
        },
        "windowMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "usedPercent",
        "source",
        "observedAt"
      ]
    },
    "WindowKind": {
      "description": "What kind of limit a window represents.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "other"
          ]
        },
        {
          "description": "Short rolling window (e.g. 5 hours).",
          "type": "string",
          "const": "session"
        },
        {
          "description": "Weekly window across all models.",
          "type": "string",
          "const": "weekly"
        },
        {
          "description": "Model- or feature-scoped window.",
          "type": "string",
          "const": "model"
        }
      ]
    }
  }
}
